# Скопируйте этот файл в .env и заполните. Файл .env не попадает в Git.
# Все ключи читаются только сервером и не передаются в браузер.

# Название команды — попадает в results.json для организаторов.
TEAM_NAME=

# Ссылка GET на API организаторов (кнопка «Открыть GET для DEV» в методичке).
# Параметр group_id сервер подставит сам из поля в интерфейсе.
ORGANIZER_API_URL=

# Основная модель — OpenAI (оценка чатов; звонков — если нет ключа Gemini).
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Модели, которые можно выбрать в интерфейсе (через запятую).
OPENAI_MODELS=gpt-6-luna,gpt-4o-mini,gpt-4.1-mini,gpt-4.1,gpt-4o
# Цена за 1 млн токенов в USD — для расчёта стоимости оценки. Сверьте с openai.com/api/pricing.
OPENAI_PRICE_INPUT_PER_1M=0.10
OPENAI_PRICE_OUTPUT_PER_1M=0.50

# Gemini (необязательно, но нужен для звонков): слушает запись звонка — интонация, дикция, темп,
# ошибки распознавания — и служит запасной моделью, если OpenAI не ответил. Пустой ключ — без звука и без запасной.
# Ключ: https://aistudio.google.com/apikey
LLM_FALLBACK=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Анализ записи звонков через Gemini: on / off; сколько записей анализировать одновременно
AUDIO_ANALYSIS=on
AUDIO_CONCURRENCY=2
# Цена Gemini берётся из встроенной таблицы; при необходимости задайте свою (USD за 1 млн токенов)
GEMINI_PRICE_INPUT_PER_1M=
GEMINI_PRICE_OUTPUT_PER_1M=

# Сколько диалогов оценивать параллельно.
EVAL_CONCURRENCY=3
DATABASE_PATH=data/cqa.sqlite
PORT=8765
